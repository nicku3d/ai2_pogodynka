{% extends 'base.html.twig' %}

{% block title %}Measurement{% endblock %}

{% block body %}
    <main class="container py-4">
        <h1>Measurement</h1>

        <table class="table table-striped">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ measurement.id }}</td>
                </tr>
                <tr>
                    <th>Date</th>
                    <td>{{ measurement.date ? measurement.date|date('Y-m-d') : '' }}</td>
                </tr>
                <tr>
                    <th>Celsius</th>
                    <td>{{ measurement.celsius }}</td>
                </tr>
            </tbody>
        </table>

        <a class="btn btn-outline-secondary my-2" href="{{ path('app_measurement_index') }}">back to list</a>

        <a class="btn btn-outline-primary" href="{{ path('app_measurement_edit', {'id': measurement.id}) }}">edit</a>

        {{ include('measurement/_delete_form.html.twig') }}
    </main>
{% endblock %}
