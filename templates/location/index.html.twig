{% extends 'base.html.twig' %}

{% block title %}Location index{% endblock %}

{% block body %}
    <main class="container py-4">
        <h1>Location index</h1>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>City</th>
                    <th>Country</th>
                    <th>Latitude</th>
                    <th>Longitude</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody>
            {% for location in locations %}
                <tr>
                    <td>{{ location.id }}</td>
                    <td>{{ location.city }}</td>
                    <td>{{ location.country }}</td>
                    <td>{{ location.latitude }}</td>
                    <td>{{ location.longitude }}</td>
                    <td>
                        <a class="btn btn-outline-secondary" href="{{ path('app_location_show', {'id': location.id}) }}">show</a>
                        <a class="btn btn-outline-primary" href="{{ path('app_location_edit', {'id': location.id}) }}">edit</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <a class="btn btn-primary" href="{{ path('app_location_new') }}">Create new</a>
    </main>
{% endblock %}
