{% extends 'base.html.twig' %}

{% block title %}Location{% endblock %}

{% block body %}
    <main class="container py-4">
        <h1>Location</h1>

        <table class="table table-striped">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ location.id }}</td>
                </tr>
                <tr>
                    <th>City</th>
                    <td>{{ location.city }}</td>
                </tr>
                <tr>
                    <th>Country</th>
                    <td>{{ location.country }}</td>
                </tr>
                <tr>
                    <th>Latitude</th>
                    <td>{{ location.latitude }}</td>
                </tr>
                <tr>
                    <th>Longitude</th>
                    <td>{{ location.longitude }}</td>
                </tr>
            </tbody>
        </table>

        <a class="btn btn-outline-secondary my-2" href="{{ path('app_location_index') }}">back to list</a>

        <a class="btn btn-outline-primary" href="{{ path('app_location_edit', {'id': location.id}) }}">edit</a>

        {{ include('location/_delete_form.html.twig') }}
    </main>
{% endblock %}
